@model IEnumerable<PupV1.Models.Puppy>
@{
    ViewData["Title"] = "Puppies";
}
<h1 class="mb-4">Available Puppies</h1>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var puppy in Model)
    {
        <div class="col">
            <a asp-action="Puppy" asp-controller="Client" asp-route-id="@puppy.PuppyId" style="text-decoration: none; color: inherit;">
                <div class="card h-100 shadow-sm">
                    <img src="@puppy.ImageUrl" class="card-img-top" alt="@puppy.PuppyName" style="object-fit: cover; height: 200px;">
                    <div class="card-body">
                        <h5 class="card-title">@puppy.PuppyName</h5>
                        <p class="card-text">
                            <strong>Gender:</strong> @puppy.Gender <br />
                            <strong>Size:</strong> @puppy.Size
                        </p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
