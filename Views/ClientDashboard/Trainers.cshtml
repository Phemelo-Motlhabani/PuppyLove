@model IEnumerable<PupV1.Models.Trainer>

@{
    ViewData["Title"] = "Trainers";
}

<h1 class="mb-4">Trainers</h1>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var trainer in Model)
    {
        <div class="col">
            <a asp-action="Trainer" asp-controller="Client" asp-route-id="@trainer.TrainerId" style="text-decoration: none; color: inherit;">
                <div class="card h-100 shadow-sm">
                    <img src="@trainer.ImageUrl" class="card-img-top" alt="@trainer.TrainerId" style="object-fit: cover; height: 200px;">
                    <div class="card-body">
                        <h5 class="card-title">@trainer.Fname @trainer.Lname</h5>
                        <p class="card-text">
                            <strong>Gender:</strong> @trainer.Suburb <br />
                            <strong>Size:</strong> @trainer.City
                        </p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
