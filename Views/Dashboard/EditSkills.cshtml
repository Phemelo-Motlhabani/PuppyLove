@{
}
@model TrainerSkillsFormViewModel

@{
    ViewData["Title"] = "edit Skills";
}
<h2>Select your skills</h2>

<form asp-action ="EditSkills" method="post">
    @for (int i = 0; i < Model.Skills.Count; i++)
    {
        <div class="form-check mb-2">
            <input class="form-check-input" asp-for = "Skills[@i].IsSelected" />
            <label class="form-check-label">@Model.Skills[i].SkillName</label>

            <select asp-for ="Skills[@i].SkillLevel" class="form-select mt-1">
                <option>Beginner</option>
                <option>Intermediate</option>
                <option>Expert</option>
            </select>

            <input type="hidden" asp-for="Skills[@i].SkillId" />
            <input type="hidden" asp-for="Skills[@i].SkillName" />
        </div>
    }
    <button type="submit" class="btn btn-primary mt-3">Save</button> 
</form>
