@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model PupV1.Models.DashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
}
<div class="container-fluid py-4">
    
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-gradient" style="background: #667eea;">
                <div class="card-body text-white py-4">
                    <h1 class="display-5 mb-0">
                        <i class="bi bi-person-circle"></i> Welcome, @Model.Name!
                    </h1>
                    <p class="lead mb-0 opacity-75">Manage your training sessions and profile</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> <strong>Success!</strong> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
       
        <div class="col-lg-4 mb-4">
            
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 pt-3">
                    <h5 class="mb-0"><i class="bi bi-person-badge"></i> Your Profile</h5>
                </div>
                <div class="card-body text-center">
                    <img src="@Model.ImageUrl" class="rounded-circle mb-3 border border-3 border-primary" 
                         style="width: 150px; height: 150px; object-fit: cover;" alt="Profile Picture" />
                    
                    <h4 class="mb-1">@Model.Name @Model.Surname</h4>
                    <p class="text-muted mb-3">
                        <i class="bi bi-geo-alt"></i> @Model.Suburb, @Model.City
                    </p>
                    <p class="mb-0">
                        <i class="bi bi-telephone"></i> @Model.CellNUm
                    </p>

                    <button class="btn btn-outline-primary mt-3 w-100" onclick="toggleProfile()">
                        <i class="bi bi-pencil"></i> Edit Profile
                    </button>

                   
                    <div id="profileDiv" style="display:none;" class="mt-3 text-start">
                        <hr />
                        <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label">Name</label>
                                <input asp-for="Name" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Surname</label>
                                <input asp-for="Surname" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Suburb</label>
                                <input asp-for="Suburb" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">City</label>
                                <input asp-for="City" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Phone Number</label>
                                <input asp-for="CellNUm" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="ImageFile" class="form-label">Upload New Image</label>
                                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                                <span asp-validation-for="ImageFile" class="text-danger"></span>
                            </div>
                            <input type="hidden" asp-for="Username" />
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-save"></i> Save Changes
                                </button>
                                <button type="button" class="btn btn-secondary" onclick="toggleProfile()">
                                    <i class="bi bi-x"></i> Cancel
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-3">
                    <h5 class="mb-0"><i class="bi bi-star-fill text-warning"></i> Your Skills</h5>
                </div>
                <div class="card-body">
                    @if (Model.SelectedSkills != null && Model.SelectedSkills.Count > 0)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var skill in Model.SelectedSkills)
                            {
                                <div class="list-group-item px-0 border-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-check-circle-fill text-success"></i> @skill.SkillName</span>
                                        <span class="badge bg-primary rounded-pill">@skill.SkillLevel</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle"></i> No skills selected yet!
                        </div>
                    }

                    <a href="/Dashboard/EditSkills" class="btn btn-outline-secondary mt-3 w-100">
                        <i class="bi bi-gear"></i> Manage Skills
                    </a>
                </div>
            </div>

           
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-3">Quick Actions</h6>
                    <a asp-controller="Parkrecommendation" asp-action="Create" class="btn btn-success w-100">
                        <i class="bi bi-tree"></i> Recommend a Park
                    </a>
                </div>
            </div>
        </div>

        
        <div class="col-lg-8">
            
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 pt-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-inbox-fill text-primary"></i> Incoming Training Requests
                        </h5>
                        @if (Model.TrainingRequests.Any())
                        {
                            <span class="badge bg-warning text-dark rounded-pill">@Model.TrainingRequests.Count Pending</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (!Model.TrainingRequests.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-1 text-muted"></i>
                            <p class="text-muted mt-3 mb-0">No training requests at the moment.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th><i class="bi bi-person"></i> Client</th>
                                        <th><i class="bi bi-bookmark"></i> Program</th>
                                        <th><i class="bi bi-circle-fill"></i> Status</th>
                                        <th><i class="bi bi-calendar"></i> Date</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in Model.TrainingRequests)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-circle bg-primary text-white me-2" style="width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                                        @req.Client.Fname.Substring(0, 1)@req.Client.Lname.Substring(0, 1)
                                                    </div>
                                                    <div>
                                                        <strong>@req.Client.Fname @req.Client.Lname</strong>
                                                        <br />
                                                        <small class="text-muted">@req.DogName (@req.DogBreed)</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info text-dark">@req.TrainingProgram</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-warning text-dark">@req.RequestStatus</span>
                                            </td>
                                            <td>
                                                <small>@req.RequestDate.ToString("MMM dd, yyyy")</small>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    
                                                    <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" 
                                                            data-bs-target="#detailsModal@(req.TrequestId)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>

                                                    
                                                    <form asp-controller="Dashboard" asp-action="AcceptRequest" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@req.TrequestId" />
                                                        <button type="submit" class="btn btn-success btn-sm">Accept</button>
                                                    </form>

                                                   
                                                    <form asp-controller="Dashboard" asp-action="RejectRequest" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@req.TrequestId" />
                                                        <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                                                    </form>
                                                    
                                                </div>
                                            </td>
                                        </tr>

                                        
                                        <div class="modal fade" id="detailsModal@(req.TrequestId)" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-primary text-white">
                                                        <h5 class="modal-title">
                                                            <i class="bi bi-file-text"></i> Request Details
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="row mb-3">
                                                            <div class="col-6">
                                                                <p class="mb-1 text-muted small">CLIENT</p>
                                                                <p class="fw-bold">@req.Client.Fname @req.Client.Lname</p>
                                                            </div>
                                                            <div class="col-6">
                                                                <p class="mb-1 text-muted small">CONTACT</p>
                                                                <p>@req.Client.CellNum</p>
                                                            </div>
                                                        </div>
                                                        <hr />
                                                        <div class="row mb-3">
                                                            <div class="col-6">
                                                                <p class="mb-1 text-muted small">DOG NAME</p>
                                                                <p class="fw-bold">@req.DogName</p>
                                                            </div>
                                                            <div class="col-6">
                                                                <p class="mb-1 text-muted small">BREED</p>
                                                                <p>@req.DogBreed</p>
                                                            </div>
                                                        </div>
                                                        <div class="row mb-3">
                                                            <div class="col-6">
                                                                <p class="mb-1 text-muted small">AGE</p>
                                                                <p>@req.DogAge years</p>
                                                            </div>
                                                            <div class="col-6">
                                                                <p class="mb-1 text-muted small">PROGRAM</p>
                                                                <p><span class="badge bg-info">@req.TrainingProgram</span></p>
                                                            </div>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(req.AdditionalInfo))
                                                        {
                                                            <hr />
                                                            <p class="mb-1 text-muted small">ADDITIONAL INFORMATION</p>
                                                            <p class="text-muted">@req.AdditionalInfo</p>
                                                        }
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Dog</th>
                            <th>Owner</th>
                            <th>Program</th>
                            <th style="min-width: 300px;">Progress Notes</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.TrainingProgresses)
                        {
                            <tr class="@(item.IsFinished ? "table-secondary" : "")">
                                <td>
                                    <strong>@item.DogName</strong><br />
                                    <small class="text-muted">@item.DogBreed</small>
                                </td>
                                <td>@item.OwnerName</td>
                                <td>
                                    <span class="badge bg-primary">@item.Program</span>
                                </td>
                                <td style="min-width: 300px;">
                                    <form asp-action="UpdateProgress" asp-controller="Dashboard" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ProgressId" value="@item.ProgressId" />
                                        <input type="hidden" name="IsFinished" value="@item.IsFinished" />
                                        <div class="input-group input-group-sm">
                                            <textarea name="ProgressNotes" class="form-control" rows="2"
                                                      placeholder="Add progress notes...">@item.ProgressNotes</textarea>
                                            <button type="submit" class="btn btn-outline-primary" title="Save Notes">
                                                <i class="bi bi-save"></i>
                                            </button>
                                        </div>
                                    </form>
                                </td>
                                <td>
                                    @if (item.IsFinished)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-hourglass-split"></i> In Progress
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!item.IsFinished)
                                    {
                                        <form asp-action="FinishTraining" asp-controller="Dashboard"
                                              asp-route-id="@item.ProgressId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm"
                                                    onclick="return confirm('Mark training for @item.DogName as finished?')">
                                                <i class="bi bi-flag-fill"></i> Complete
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="bi bi-check-all"></i> Done
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
    </div>
</div>

@section Scripts
{
    <script>
        function toggleProfile() { 
            var div = document.getElementById("profileDiv");
            var isHidden = div.style.display === "none" || div.style.display === "";
            div.style.display = isHidden ? "block" : "none";
            
            
            if (isHidden) {
                setTimeout(function() {
                    div.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }, 100);
            }
        }
    </script>
    <script>
        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function(e) {
                console.log('Form submitting to:', this.action);
                console.log('Method:', this.method);
                console.log('Request ID:', this.querySelector('[name="id"]')?.value);
            });
        });
    </script>
        <style>
           
            .btn-group .d-inline {
                display: inline-block !important;
            }

           
            .btn-group form {
                margin: 0;
                padding: 0;
            }

            
            .update-progress-form textarea {
                resize: vertical;
                min-height: 50px;
            }

            
            .d-flex.gap-1 {
                gap: 0.25rem;
            }
        </style>
}


