@{
}
@model PupV1.Models.DashboardViewModel

    <h2>Incoming Training Requests</h2>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Client</th>
                <th>Program</th>
                <th>Status</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var req in Model.TrainingRequests)
            {
            <tr>
                <td>@req.Client.Fname @req.Client.Lname</td>
                <td>@req.TrainingProgram</td>
                <td>@req.RequestStatus</td>
                <td>@req.RequestDate.ToShortDateString()</td>
                <td>
                    @if (req.RequestStatus == "Pending")
                    {
                        <form asp-action="AcceptRequest" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@req.TrequestId" />
                            <button class="btn btn-success btn-sm">Accept</button>
                        </form>
                        <form asp-action="RejectRequest" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@req.TrequestId" />
                            <button class="btn btn-danger btn-sm">Reject</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
