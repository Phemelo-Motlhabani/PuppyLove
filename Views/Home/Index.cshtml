<div class="swiper mySwiper">
    <div class="swiper-wrapper">
        @foreach (var park in Model)
        {
            <div class="swiper-slide text-center" style="height: 250px;">
                <img src="@park.ImageUrl" class="img-fluid" style="height:200px; object-fit:cover;" />
                <div class="mt-2">
                    <h6>@park.ParkName</h6>
                    <p>@park.Suburb, @park.City</p>
                    </div>
                    </div>
        }
    </div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
</div>