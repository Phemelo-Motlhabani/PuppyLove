@model PupV1.Models.CreateLitterViewModel
@{
    ViewData["Title"] = "Create New Litter";
}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2>Create New Litter</h2>

            <form asp-action="Create" method="post" class="mt-4">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="BreedId"></label>
                    <input asp-for="BreedId" class="form-control" placeholder="e.g., Golden Retriever, Labrador" />
                    <span asp-validation-for="BreedId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NumPuppies"></label>
                    <input asp-for="NumPuppies" type="number" class="form-control" min="1" max="20" />
                    <span asp-validation-for="NumPuppies" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="BirthDate"></label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Notes"></label>
                    <textarea asp-for="Notes" class="form-control" rows="4"
                              placeholder="Any additional information about this litter..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Litter</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
