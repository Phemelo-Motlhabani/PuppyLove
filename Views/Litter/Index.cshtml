    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<PupV1.Models.Litter>
@{
    ViewData["Title"] = "My Litters";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Litters</h2>
        <a asp-controller="Litter" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Litter
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h4>No Litters Yet</h4>
            <p>No litters have been created. Click "Create New Litter" to get started!</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var litter in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@litter?.BreedType?.BreedName</h5>
                            <p class="text-muted">Born: @(litter.BirthDate.HasValue ? litter.BirthDate.Value.ToString("MMMM dd, yyyy") : "N/A") </p>

                            <div class="mb-3">
                                <span class="badge bg-primary">Total: @litter.NumPuppies</span>
                                <span class="badge bg-success">Available: @litter.AvailablePuppies</span>
                                <span class="badge bg-secondary">Sold: @(litter.NumPuppies - litter.AvailablePuppies)</span>
                            </div>

                            <div class="progress mb-3" style="height: 25px;">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width: @((litter.AvailablePuppies * 100.0 / litter.NumPuppies))%">
                                    @litter.AvailablePuppies Available
                                </div>
                            </div>

                            <a asp-action="Details" asp-route-id="@litter.LitterId" class="btn btn-outline-primary btn-sm">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
<a asp-controller="BreederDashboard" asp-action="Index" class="btn btn-secondary mt-3">Back</a>