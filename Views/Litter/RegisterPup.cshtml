    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model PupV1.Models.RegisterPuppyViewModel
@{
    ViewData["Title"] = "Register Puppy";
}
div class="container mt-4">
<div class="row">
    <div class="col-md-8 offset-md-2">
        <h2>Register New Puppy</h2>

        <form asp-action="Register" method="post" enctype="multipart/form-data" class="mt-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="LitterId"></label>
                <select asp-for="LitterId" class="form-select">
                    @foreach (var litter in Model.AvailableLitters)
                    {
                        <option value="@litter.LitterId">
                            @litter.DisplayText
                           @* @litter.BreedType - Born @litter.BirthDate.ToString("MM/dd/yyyy")
                            (@litter.AvailablePuppies available)*@
                        </option>
                    }
                </select>
                <span asp-validation-for="LitterId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="PuppyName"></label>
                        <input asp-for="PuppyName" class="form-control" placeholder="e.g., Max, Bella" />
                        <span asp-validation-for="PuppyName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Gender"></label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option value="M">Male</option>
                            <option value="F">Female</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-RetryClaude does not have the ability to run the code it generates danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Weight"></label>
                        <input asp-for="Weight" type="number" step="0.1" class="form-control" placeholder="kg" />
                        <span asp-validation-for="Weight" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Colour"></label>
                        <input asp-for="Colour" class="form-control" placeholder="e.g., Golden, Black & White" />
                        <span asp-validation-for="Colour" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price"></label>
                <div class="input-group">
                    <span class="input-group-text">R</span>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                </div>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="HealthStatus"></label>
                <input asp-for="HealthStatus" class="form-control" placeholder="e.g., Healthy, Excellent" />
                <span asp-validation-for="HealthStatus" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-check">
                        <input asp-for="IsVaccinated" class="form-check-input" type="checkbox" />
                        <label asp-for="IsVaccinated" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check">
                        <input asp-for="IsMicrochipped" class="form-check-input" type="checkbox" />
                        <label asp-for="IsMicrochipped" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <label asp-for="VaccinationDate" class="form-label"></label>
                    <input asp-for="VaccinationDate" type="date" class="form-control" />
                    <span asp-validation-for="VaccinationDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MicrochipNumber" class="form-label"></label>
                    <input asp-for="MicrochipNumber" class="form-control" placeholder="Chip number" />
                    <span asp-validation-for="MicrochipNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="4"
                          placeholder="Describe the puppy's personality, temperament, etc."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImageFiles">Puppy Photos</label>
                <input asp-for="ImageFiles" type="file" class="form-control" accept="image/*" multiple />
                <span asp-validation-for="ImageFiles" class="text-danger"></span>
                <small class="form-text text-muted">You can select multiple images</small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Register Puppy</button>
                <a asp-controller="Litter" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div>
