@{
}
@model PupV1.Models.Parkrecommendation

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
        <h2>Recommend a Park</h2>
<form asp-action="Create" enctype="multipart/form-data" id="parkForm" method="post">
    <div class="form-group mb-3">
        <label asp-for="ParkName"></label>
        <input asp-for="ParkName" class="form-control" />
        <span asp-validation-for="ParkName" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Suburb"></label>
        <input asp-for="Suburb" class="form-control" />
        <span asp-validation-for="Suburb" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="City"></label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="ImageFile">Upload Image</label>
        <input asp-for="ImageFile" type="file" class="form-control" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Post</button>
        <button type="reset" class="btn btn-warning">Clear</button>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
    <div asp-validation-summary="All" class="text-danger"></div>
    </form>
</div>
</div>
</div>
