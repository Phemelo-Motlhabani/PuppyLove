    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<PupV1.Models.Puppy>
@{
    ViewData["Title"] = "All Puppies";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-heart-fill"></i> All My Puppies</h2>
            <p class="text-muted">Manage all puppies across all litters</p>
        </div>
        <div>
            <a asp-controller="Litter" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-collection"></i> View by Litter
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h4><i class="bi bi-info-circle"></i> No Puppies Yet</h4>
            <p>You haven't registered any puppies yet.</p>
            <a asp-controller="Litter" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create a Litter First
            </a>
        </div>
    }
    else
    {
        
        <ul class="nav nav-tabs mb-4" id="puppyTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button">
                    All Puppies <span class="badge bg-primary">@Model.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="available-tab" data-bs-toggle="tab" data-bs-target="#available" type="button">
                    Available <span class="badge bg-success">@Model.Count(p => p.Status == "Available" || string.IsNullOrEmpty(p.Status))</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="sold-tab" data-bs-toggle="tab" data-bs-target="#sold" type="button">
                    Sold <span class="badge bg-secondary">@Model.Count(p => p.Status == "Sold")</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="puppyTabsContent">
           
            <div class="tab-pane fade show active" id="all" role="tabpanel">
                <div class="row">
                    @foreach (var puppy in Model.OrderBy(p => p.PuppyName))
                    {
                        @await Html.PartialAsync("_PuppyCard", puppy)
                    }
                </div>
            </div>

            
            <div class="tab-pane fade" id="available" role="tabpanel">
                <div class="row">
                    @foreach (var puppy in Model.Where(p => p.Status == "Available" || string.IsNullOrEmpty(p.Status)).OrderBy(p => p.PuppyName))
                    {
                        @await Html.PartialAsync("_PuppyCard", puppy)
                    }
                </div>
            </div>

            
            <div class="tab-pane fade" id="sold" role="tabpanel">
                <div class="row">
                    @foreach (var puppy in Model.Where(p => p.Status == "Sold").OrderBy(p => p.PuppyName))
                    {
                        @await Html.PartialAsync("_PuppyCard", puppy)
                    }
                </div>
            </div>
        </div>
    }
</div>
<div class="text-center mt-4">
    <button type="button" class="btn btn-outline-primary px-4" onclick="history.back()">
        <i class="bi bi-arrow-left"></i> Back
    </button>
</div>

