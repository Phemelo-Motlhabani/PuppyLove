    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<PupV1.Models.Puppyrequest>
@{

}
@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No requests in this category.
    </div>
}
else
{
    <div class="row">
        @foreach (var request in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title">@request.Puppy?.PuppyName</h5>
                            @if (request.Status == "Pending")
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (request.Status == "Accepted")
                            {
                                <span class="badge bg-success">Accepted</span>
                            }
                            else if (request.Status == "Rejected")
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </div>

                        <div class="row mb-3">
                            <div class="col-4">
                                <img src="@request.Puppy?.ImageUrl" class="img-fluid rounded" alt="@request.Puppy?.PuppyName" />
                            </div>
                            <div class="col-8">
                                <p class="mb-1"><strong>Breed:</strong> @request.Puppy?.Litter?.BreedType?.BreedName</p>
                                <p class="mb-1"><strong>Price:</strong> R @request.Puppy?.Price?.ToString("N2")</p>
                                <p class="mb-1"><strong>Requested:</strong> @request.RequestDate.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>

                        <div class="card bg-light mb-3">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2">Client Information:</h6>
                                <p class="mb-1"><strong>Name:</strong> @request.Client?.Fname @request.Client?.Lname</p>
                                <p class="mb-1"><strong>Email:</strong> @request.Client?.Email</p>
                                <p class="mb-1"><strong>Phone:</strong> @request.Client?.CellNum</p>
                                <p class="mb-0"><strong>Location:</strong> @request.Client?.City</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <strong>Client's Message:</strong>
                            <p class="text-muted">@request.Message</p>
                        </div>

                        @if (!string.IsNullOrEmpty(request.BreederResponse))
                        {
                            <div class="alert alert-info">
                                <strong>Your Response:</strong>
                                <p class="mb-0">@request.BreederResponse</p>
                            </div>
                        }

                        @if (request.Status == "Pending")
                        {
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#acceptModal-@request.RequestId">
                                    <i class="bi bi-check-circle"></i> Accept Request
                                </button>
                                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@request.RequestId">
                                    <i class="bi bi-x-circle"></i> Reject Request
                                </button>
                            </div>

                
                            <div class="modal fade" id="acceptModal-@request.RequestId" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="RespondToRequest" method="post">
                                            <div class="modal-header bg-success text-white">
                                                <h5 class="modal-title">Accept Request</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="requestId" value="@request.RequestId" />
                                                <input type="hidden" name="status" value="Accepted" />

                                                <p>You're about to accept this request for <strong>@request.Puppy?.PuppyName</strong>.</p>

                                                <div class="form-group">
                                                    <label>Response Message (Optional)</label>
                                                    <textarea name="breederResponse" class="form-control" rows="3"
                                                              placeholder="e.g., Thank you for your interest! Please contact me at..."></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-success">Accept Request</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            
                            <div class="modal fade" id="rejectModal-@request.RequestId" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="RespondToRequest" method="post">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title">Reject Request</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="requestId" value="@request.RequestId" />
                                                <input type="hidden" name="status" value="Rejected" />

                                                <p>You're about to reject this request for <strong>@request.Puppy?.PuppyName</strong>.</p>

                                                <div class="form-group">
                                                    <label>Reason (Optional)</label>
                                                    <textarea name="breederResponse" class="form-control" rows="3"
                                                              placeholder="e.g., Sorry, the puppy has been reserved by another client..."></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-danger">Reject Request</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (request.Status == "Accepted")
                        {
                            @if (request.Puppy?.Status != "Sold")
                            {
                                <form asp-action="MarkAsSold" asp-route-requestId="@request.RequestId" method="post"
                                      onsubmit="return confirm('Confirm that payment has been received offline and mark this puppy as sold?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-bag-check"></i> Mark as Sold (Payment Received)
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="alert alert-success">
                                    <i class="bi bi-check-circle"></i> This puppy has been sold!
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
