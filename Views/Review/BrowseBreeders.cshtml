    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<PupV1.Models.ProviderWithReviewsViewModel>
@{
    ViewData["Title"] = "Browse Breeders";
}
<div class="container mt-4">
    <h2><i class="bi bi-heart"></i> Browse Breeders</h2>
    <p class="lead text-muted">Find reputable dog breeders based on client reviews</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h4><i class="bi bi-info-circle"></i> No Breeders Yet</h4>
            <p>There are currently no breeders available.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var breeder in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 text-center">
                                    <img src="@breeder.ImageUrl" class="img-fluid rounded-circle mb-3"
                                         alt="@breeder.ProviderName" style="width: 120px; height: 120px; object-fit: cover;" />

                                    <div class="mb-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Round(breeder.AverageRating))
                                            {
                                                <i class="bi bi-star-fill text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-warning"></i>
                                            }
                                        }
                                    </div>
                                    <p class="mb-0">
                                        <strong>@breeder.AverageRating.ToString("F1")</strong> / 5.0<br />
                                        <small class="text-muted">(@breeder.TotalReviews reviews)</small>
                                    </p>
                                </div>

                                <div class="col-md-8">
                                    <h5 class="card-title">@breeder.ProviderName</h5>
                                    @if (!string.IsNullOrEmpty(breeder.KennelName))
                                    {
                                        <p class="text-muted"><i class="bi bi-house"></i> @breeder.KennelName</p>
                                    }
                                    <p class="card-text">
                                        <i class="bi bi-geo-alt"></i> @breeder.City<br />
                                        <i class="bi bi-envelope"></i> @breeder.Email<br />
                                        <i class="bi bi-telephone"></i> @breeder.Phone
                                    </p>

                                    @if (User.IsInRole("Client"))
                                    {
                                        <a asp-action="ReviewBreeder" asp-route-id="@breeder.ProviderId" class="btn btn-primary btn-sm">
                                            <i class="bi bi-star"></i> Write a Review
                                        </a>
                                    }

                                    @if (breeder.Reviews.Any())
                                    {
                                        <hr />
                                        <h6 class="mb-2">Recent Reviews:</h6>
                                        <div style="max-height: 200px; overflow-y: auto;">
                                            @foreach (var review in breeder.Reviews.Take(3))
                                            {
                                                <div class="mb-2 p-2 bg-light rounded">
                                                    <div class="d-flex justify-content-between">
                                                        <strong class="small">@review.ClientName</strong>
                                                        <small class="text-muted">@review.ReviewDate.ToString("MMM dd, yyyy")</small>
                                                    </div>
                                                    <div class="mb-1">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            if (i <= review.Rating)
                                                            {
                                                                <i class="bi bi-star-fill text-warning small"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-star text-warning small"></i>
                                                            }
                                                        }
                                                    </div>
                                                    <p class="mb-0 small">@review.ReviewText</p>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
<div class="text-center mt-4">
    <button type="button" class="btn btn-outline-primary px-4" onclick="history.back()">
        <i class="bi bi-arrow-left"></i> Back
    </button>
</div>
