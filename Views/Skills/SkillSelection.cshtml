@{
}
@model List<SkillSelectionViewModel>

    <form asp-action="SkillSelection" method="post">
        @for(int i = 0; i <Model.Count; i++)
    {
        <div style="margin-bottom: 10px;">
            <input type="checkbox" asp-for="@Model[i].IsSelected" />
            <label>@Model[i].SkillName</label>

            <select asp-for="@Model[i].SkillLevel" class="form-control">
                <option value="">Select Level</option>
                <option>Beginner</option>
                <option>Intermediate</option>
                <option>Expert</option>
            </select>

            <input type="hidden" asp-for="@Model[i].SkillId" />
            <input type="hidden" asp-for="@Model[i].SkillName" />
        </div>
    }
    <button type="submit" class="btn btn-primary">Save</button>
</form>
