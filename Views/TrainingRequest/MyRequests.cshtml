@model IEnumerable<PupV1.Models.Trainingrequest>

@{
    ViewData["Title"] = "My Training Requests";
}

<div class="container mt-4">
    <h2>Training Requests</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <p>You have no training requests at this time.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var request in Model)
            {
                var statusClass = request.RequestStatus switch
                {
                    "Pending" => "warning",
                    "Accepted" => "success",
                    "Declined" => "danger",
                    _ => "secondary"
                };

                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header bg-@statusClass text-white">
                            <h5 class="mb-0">@request.DogName - @request.RequestStatus</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Client:</strong> @request.Client.Fname @request.Client.Lname</p>
                            <p><strong>Email:</strong> @request.Client.Email</p>
                            <p><strong>Phone:</strong> @request.Client.CellNum</p>
                            <p><strong>Dog Breed:</strong> @request.DogBreed</p>
                            <p><strong>Dog Age:</strong> @request.DogAge years</p>
                            <p><strong>Training Program:</strong> @request.TrainingProgram</p>
                            <p><strong>Request Date:</strong> @request.RequestDate.ToString("MMM dd, yyyy")</p>

                            @if (!string.IsNullOrEmpty(request.AdditionalInfo))
                            {
                                <p><strong>Additional Info:</strong> @request.AdditionalInfo</p>
                            }

                            @if (request.RequestStatus == "Pending")
                            {
                                <hr />
                                <div class="d-flex gap-2">
                                    
                                    <form asp-action="Respond" asp-controller="TrainingRequest" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@request.TrequestId" />
                                        <input type="hidden" name="status" value="Accepted" />
                                        <button type="submit" class="btn btn-success"
                                                onclick="return confirm('Accept this training request? This will create a new training progress entry.')">
                                            <i class="bi bi-check-circle"></i> Accept
                                        </button>
                                    </form>

                                    
                                    <form asp-action="Respond" asp-controller="TrainingRequest" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@request.TrequestId" />
                                        <input type="hidden" name="status" value="Declined" />
                                        <button type="submit" class="btn btn-danger"
                                                onclick="return confirm('Decline this training request?')">
                                            <i class="bi bi-x-circle"></i> Decline
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info mt-3">
                                    This request has been @request.RequestStatus.ToLower()
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
}