@model IEnumerable<PupV1.Models.Trainingrequest>

@{
    ViewData["Title"] = "Training Requests";
}

<div class="container mt-4">
    <h2>Training Requests</h2>
    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <p>You have no training requests at this time.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var request in Model)
            {
                var statusClass = request.RequestStatus switch
                {
                    "Pending" => "warning",
                    "Accepted" => "success",
                    "Rejected" => "danger",
                    _ => "secondary"
                };

                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header bg-@statusClass text-white">
                            <h5 class="mb-0">@request.DogName - @request.RequestStatus</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Client:</strong> @request.Client.Fname @request.Client.Lname</p>
                            <p><strong>Breed:</strong> @request.DogBreed (@request.DogAge years old)</p>
                            <p><strong>Request Date:</strong> @request.RequestDate.ToString("MMM dd, yyyy")</p>

                            @if (!string.IsNullOrEmpty(request.AdditionalNotes))
                            {
                                <p><strong>Additional Notes:</strong> @request.AdditionalNotes</p>
                            }

                            @if (request.RequestStatus == "Pending")
                            {
                                <hr />
                                <form asp-action="AcceptRequest" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@request.TrequestId" />
                                    <div class="mb-2">
                                        <label class="form-label">Notes for Client:</label>
                                        <textarea name="trainerNotes" class="form-control" rows="2"
                                                  placeholder="Optional message for the client"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-success"
                                            onclick="return confirm('Accept this training request?')">
                                        Accept
                                    </button>
                                </form>

                                <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                        data-bs-target="#rejectModal@(request.TrequestId)">
                                    Reject
                                </button>

                                
                                <div class="modal fade" id="rejectModal@(request.TrequestId)" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Reject Request</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="RejectRequest" method="post">
                                                <div class="modal-body">
                                                    <input type="hidden" name="id" value="@request.TrequestId" />
                                                    <div class="mb-3">
                                                        <label class="form-label">Reason for Rejection (Optional):</label>
                                                        <textarea name="trainerNotes" class="form-control" rows="3"
                                                                  placeholder="Explain why you're rejecting this request"></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
}